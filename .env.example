# 1. MongoDB Atlas Connection String (จำเป็นเมื่อ Deploy บน Vercel)
# ได้จาก https://cloud.mongodb.com -> Connect -> Drivers
MONGODB_URI=mongodb+srv://kitsvcadmin:kitsvc2570@cluster0.jtdyphj.mongodb.net/?appName=Cluster0

# 2. ระบบส่งอีเมล OTP จริง (เลือกใช้แบบใดแบบหนึ่ง):
# --------------------------------------------------------
# แบบที่ A: ใช้ Gmail SMTP (ฟรีและใช้ Gmail ของคุณเองได้ทันที)
# วิธีเอา App Password: ไปที่ Google Account -> ความปลอดภัย -> การยืนยัน 2 ขั้นตอน -> รหัสผ่านสำหรับแอป (App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="IT Academy" <your_email@gmail.com>

# --------------------------------------------------------
# แบบที่ B: ใช้ Resend (ฟรี 3,000 ฉบับ/เดือน ส่งเร็วระดับมิลลิวินาที ไม่ติด Spam)
# สมัครฟรีที่ https://resend.com แล้วสร้าง API Key
# RESEND_API_KEY=re_xxxxxxxxxxxx
